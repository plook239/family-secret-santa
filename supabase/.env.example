# Copy to supabase/.env.local for local Edge Functions ONLY. Never commit that copy.
ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_PASSWORD_OF_AT_LEAST_16_CHARACTERS
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
RESEND_API_KEY=REPLACE_WITH_RESEND_API_KEY
EMAIL_FROM=Family Secret Santa <santa@your-verified-domain.com>
PUBLIC_SITE_URL=https://YOUR_USERNAME.github.io/family-secret-santa/
# Hosted Edge Functions automatically receive SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY.
# Do not place those keys in js/config.js or any browser code.
